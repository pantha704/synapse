# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # server-only, never NEXT_PUBLIC_

# Database (Prisma). Use the pooled connection for the app, direct for migrations.
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
DIRECT_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Groq (server-only). NEXT_PUBLIC_ prefix would ship this to the browser.
GROQ_API_KEY=<gsk_...>
# Chat model. llama-3.3-70b-versatile was retired by Groq; this is the current default.
CHAT_MODEL=openai/gpt-oss-120b

# Embeddings are OPTIONAL. Groq retired nv-embedqa-e5-v5 (EOL 2026-08-25).
# Leave these blank and retrieval uses PostgreSQL full-text search instead.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# Public origin used for auth callback and invite redirects.
# Leave unset behind a proxy that sets x-forwarded-host; set it anywhere else.
NEXT_PUBLIC_SITE_URL=https://your-app.example.com
